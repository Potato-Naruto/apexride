# Server
PORT=3001
# Routing engine (OSRM-compatible). The public demo server is for development only - self-host or use a paid provider in production.
OSRM_URL=https://router.project-osrm.org
# Nominatim geocoder (set a real contact in the UA per usage policy)
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_UA=ApexRide/0.1 (you@example.com)
CORS_ORIGIN=http://localhost:5173

# Client (Vite) - all optional. Defaults use OpenFreeMap: free, no API key, no signup, commercial use OK.
# VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
# VITE_TILEJSON_URL=https://tiles.openfreemap.org/planet
# VITE_MAP_ATTRIBUTION=...
